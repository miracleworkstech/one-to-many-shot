  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Maya taps Generate a batch on the status page",
        "enqueue makes two candidates per ready product, priority first, in one transaction",
        "The worker submits to Luma, polls (no callbacks), saves JPEGs to the volume",
        "One Slack post per settled batch, linking to the first product to decide"
      ]
    },
    {
      "dot": "amber",
      "title": "Money and state",
      "items": [
        "Refused past 40 images in flight or $50 lifetime spend, reason in plain words",
        "Cost recorded at submission; pauses on budget, auth, forbidden; five attempts",
        "Four tables; images kept twice: original for export, small copy for the phone",
        "One instance, no backup on Hobby; scale order: object storage, Postgres, replica"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries and outside calls",
      "items": [
        "One shared token as a cookie on every route except /healthz; redirects use APP_URL",
        "Photo fetch refuses private address space; secrets only from the environment",
        "Luma: paid, polled, typed errors. Claude Haiku: one call per import, template fallback",
        "Slack webhook skipped if unset; customer photos fetched with a browser user agent"
      ]
    }
  ]
