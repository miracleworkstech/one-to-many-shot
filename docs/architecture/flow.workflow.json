  "cards": [
    {
      "dot": "cyan",
      "title": "In",
      "items": [
        "Same nine columns as the export; a re-import updates ideas and never touches an approval",
        "Sheet ideas are kept as written; suggestions are labelled and free until generated",
        "A note like \"do this one first\" sets priority"
      ]
    },
    {
      "dot": "emerald",
      "title": "Make",
      "items": [
        "Two candidates per product, priority first, inside the in-flight and spend caps",
        "The worker polls because the Agents API has no callbacks",
        "Images are copied out on completion; Luma's URLs expire in an hour"
      ]
    },
    {
      "dot": "violet",
      "title": "Out",
      "items": [
        "One Slack message per settled round, never one per image",
        "A product is done at two approved images",
        "Files named like HG-002-morning-kitchen-01.jpg; the CSV carries status and links"
      ]
    }
  ]
