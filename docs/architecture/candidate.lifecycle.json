{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Candidate Lifecycle",
    "output": "candidate-lifecycle.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "Queued to approved",
        "focus": [
          "queued",
          "processing",
          "completed",
          "approved"
        ],
        "note": "One row per image: the worker moves it, Ellie decides it."
      },
      {
        "id": "decisions",
        "label": "Reject and change of mind",
        "focus": [
          "completed",
          "rejected",
          "approved"
        ],
        "note": "A rejection folds away but stays approvable; the ledger never changes."
      },
      {
        "id": "failure",
        "label": "Failure and try again",
        "focus": [
          "processing",
          "failed",
          "queued"
        ],
        "note": "Five attempts, then failed with the reason; Try again is a new row, never a reset."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "One candidate row"
    },
    {
      "id": "decision",
      "label": "Reviewer decision"
    },
    {
      "id": "terminal",
      "label": "Failure"
    }
  ],
  "states": [
    {
      "id": "queued",
      "type": "start",
      "label": "Queued",
      "sublabel": "written by enqueue",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "cost recorded"
    },
    {
      "id": "processing",
      "type": "active",
      "label": "Processing",
      "sublabel": "Luma job polled",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "worker"
    },
    {
      "id": "completed",
      "type": "decision",
      "label": "Completed",
      "sublabel": "image on the volume",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "needs a decision"
    },
    {
      "id": "approved",
      "type": "success",
      "label": "Approved",
      "sublabel": "named file in the zip",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "done"
    },
    {
      "id": "rejected",
      "type": "neutral",
      "label": "Rejected",
      "sublabel": "folded, still approvable",
      "lane": "decision",
      "col": 1,
      "tag": "kept"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "sublabel": "reason on the card",
      "lane": "terminal",
      "col": 0,
      "tag": "terminal"
    }
  ],
  "transitions": [
    {
      "id": "submit",
      "from": "queued",
      "to": "processing",
      "label": "submit",
      "labelDy": -25
    },
    {
      "id": "land",
      "from": "processing",
      "to": "completed",
      "label": "image saved",
      "labelDy": -25
    },
    {
      "id": "approve",
      "from": "completed",
      "to": "approved",
      "label": "Approve",
      "labelDy": -25
    },
    {
      "id": "reject",
      "from": "completed",
      "to": "rejected",
      "label": "Reject",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "approve-instead",
      "from": "rejected",
      "to": "approved",
      "label": "approve instead",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom",
      "route": "straight"
    },
    {
      "id": "fail",
      "from": "processing",
      "to": "failed",
      "label": "5th attempt, or fatal",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "left",
      "labelSegment": 0
    },
    {
      "id": "try-again",
      "from": "failed",
      "to": "queued",
      "label": "Try again: a new row",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "enqueue writes the row and its cost in the same transaction as the batch",
        "The worker submits, polls Luma, and copies the image out the moment it lands",
        "Approved renames nothing: the filename comes from the idea the row remembers"
      ]
    },
    {
      "dot": "amber",
      "title": "Decisions",
      "items": [
        "Reject folds the image below the carousel; it can still be approved",
        "A product is done at two approved images",
        "Nobody's name is recorded in the UI; decided_by exists for a second approver"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure",
      "items": [
        "A retryable error costs one of five attempts and the row stays in processing",
        "Budget, auth and forbidden pause the worker instead of failing the row",
        "A failed row keeps its cost; Try again with a note queues a new row"
      ]
    }
  ]
}
